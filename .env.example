# Copy this file to .env and fill in your credentials

# Google Gemini API (required for synthesis step)
# Free tier: 1,500 requests/day, no billing required
# Get a key at https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=AIza...

# Reddit API credentials (optional — read-only mode works without these, but rate limits are lower)
# Create an app at https://www.reddit.com/prefs/apps (select "script" type)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=WealthsimpleCommunityIntel/1.0 by u/your_username
