# Product Pulse — Backend Environment Variables
# Copy this file to .env and fill in the values.

# -------------------------------------------------------------------
# Reddit API (https://www.reddit.com/prefs/apps)
# -------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ProductPulse/1.0 (by /u/your_username)

# -------------------------------------------------------------------
# YouTube Data API v3 (https://console.cloud.google.com)
# -------------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key

# -------------------------------------------------------------------
# LLM Providers (at least one is required)
# -------------------------------------------------------------------
# Gemini 2.0 Flash — free tier, used as primary
GEMINI_API_KEY=your_gemini_api_key

# Anthropic Claude Haiku — optional middle-tier fallback
ANTHROPIC_API_KEY=your_anthropic_api_key

# -------------------------------------------------------------------
# Database
# -------------------------------------------------------------------
# Local SQLite (default)
DATABASE_URL=sqlite:///./data/pulse.db

# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql://user:password@host:5432/pulse

# -------------------------------------------------------------------
# Scheduler
# -------------------------------------------------------------------
# Cron expression for scheduled scout runs (default: daily 06:00 UTC)
SCOUT_SCHEDULE_CRON=0 6 * * *

# -------------------------------------------------------------------
# CORS (comma-separated list of allowed origins)
# -------------------------------------------------------------------
# Use * for development, restrict to your frontend URL in production
CORS_ORIGINS=http://localhost:3000
